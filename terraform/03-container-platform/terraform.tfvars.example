# Copy to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars to source control.

aws_region   = "us-east-1"
project_name = "myapp"

# Retrieve these from Example 1 outputs (or your existing VPC)
vpc_id             = "vpc-0abc123def456"
private_subnet_ids = ["subnet-0aaa", "subnet-0bbb"]
public_subnet_ids  = ["subnet-0ccc", "subnet-0ddd"]

# Retrieve this from Example 2 outputs (or any container image)
container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/myapp-dev:latest"
container_port  = 8080

container_cpu    = 256
container_memory = 512

desired_count = 2
min_capacity  = 1
max_capacity  = 10

health_check_path = "/health"

# Leave empty to use HTTP only
certificate_arn = ""
