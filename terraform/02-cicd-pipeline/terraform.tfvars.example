# Copy to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars to source control.

aws_region   = "us-east-1"
project_name = "myapp"

github_owner  = "my-org"
github_repo   = "my-repo"
github_branch = "main"

ecs_cluster_name = "my-ecs-cluster"
ecs_service_name = "my-ecs-service"
